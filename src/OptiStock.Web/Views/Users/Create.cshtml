@model OptiStock.Web.Controllers.UsersController.CreateUserForm
@{ ViewData["Title"] = "Novo usuário"; }
<main class="container py-4 form-page"><h1 class="h2">Novo usuário</h1><form asp-action="Create" method="post" class="card mt-3"><div class="card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="col-md-6"><label asp-for="DisplayName" class="form-label">Nome</label><input asp-for="DisplayName" class="form-control" required maxlength="120" /></div><div class="col-md-6"><label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" type="email" class="form-control" required /></div>
<div class="col-md-6"><label asp-for="Password" class="form-label">Senha inicial</label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" required minlength="8" /><div class="form-text">Use pelo menos 8 caracteres. Não é obrigatório combinar maiúsculas, números ou símbolos.</div></div><div class="col-md-6"><label asp-for="Role" class="form-label">Perfil</label><select asp-for="Role" class="form-select"><option value="Funcionário">Funcionário — usuário comum</option><option value="Administrador">Administrador</option></select><div class="form-text">Funcionário consulta o estoque, registra movimentações e lê comunicados. Administrador também gerencia cadastros, usuários e relatórios.</div></div>
<div class="col-12 d-flex gap-2"><button class="btn btn-primary">Criar usuário</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></div></form></main>
