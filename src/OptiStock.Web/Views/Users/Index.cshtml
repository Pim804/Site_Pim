@model OptiStock.Web.Controllers.UsersController.UserPage
@{ ViewData["Title"] = "Usuários"; }
<main class="container py-4">
    <header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div><h1 class="h2">Usuários</h1><p class="text-secondary mb-0">Funcionário consulta estoque, registra movimentações e acompanha comunicados. Administrador gerencia cadastros, usuários e relatórios.</p></div>
        <a asp-action="Create" class="btn btn-primary">Novo usuário</a>
    </header>
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string actionError) { <div class="alert alert-danger" role="alert">@actionError</div> }
    @if (ViewData["Error"] is string error) { <div class="alert alert-warning" role="alert">@error</div> }
    @if (Model is not null) {
        <div class="table-responsive"><table class="table table-striped align-middle">
            <thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Situação</th><th>Ações</th></tr></thead>
            <tbody>@foreach (var item in Model.Items) {
                <tr>
                    <th scope="row">@item.DisplayName</th><td>@item.Email</td>
                    <td>@string.Join(", ", item.Roles.Select(role => role == "Funcionário" ? "Funcionário (usuário comum)" : role))</td>
                    <td>@(item.IsActive ? "Ativo" : "Inativo")</td>
                    <td class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        @if (item.Id.ToString() != User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value) {
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" onsubmit="return confirm('Excluir permanentemente esta conta? A exclusão será impedida se houver movimentações ou comunicados vinculados.');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-danger">Excluir conta</button>
                            </form>
                        }
                    </td>
                </tr>
            }</tbody>
        </table></div>
        <p class="text-secondary">@Model.Total usuário(s). Contas com histórico não podem ser excluídas; use Editar para desativá-las.</p>
    }
</main>