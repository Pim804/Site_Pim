@model OptiStock.Web.Controllers.UsersController.UserPage
@{ ViewData["Title"] = "Usuários"; }
<main class="container py-4"><header class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Usuários</h1><p class="text-secondary">Contas e perfis de acesso do OptiStock.</p></div><a asp-action="Create" class="btn btn-primary">Novo usuário</a></header>
@if (ViewData["Error"] is string error) { <div class="alert alert-warning">@error</div> } @if (Model is not null) { <div class="table-responsive"><table class="table table-striped"><thead><tr><th>Nome</th><th>E-mail</th><th>Perfil</th><th>Situação</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model.Items) { <tr><th scope="row">@item.DisplayName</th><td>@item.Email</td><td>@string.Join(", ", item.Roles)</td><td>@(item.IsActive ? "Ativo" : "Inativo")</td><td><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a></td></tr> }</tbody></table></div><p class="text-secondary">@Model.Total usuário(s).</p> }</main>
