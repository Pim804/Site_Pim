@model OptiStock.Web.Controllers.CategoriesController.CategoryForm
@{ var id = ViewBag.Id as int?; ViewData["Title"] = id is null ? "Nova categoria" : "Editar categoria"; }
<main class="container py-4 form-page"><h1 class="h2">@ViewData["Title"]</h1><form asp-action="@(id is null ? "Create" : "Edit")" asp-route-id="@id" method="post" class="card mt-3"><div class="card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div><div class="col-12"><label asp-for="Name" class="form-label">Nome</label><input asp-for="Name" class="form-control" required maxlength="100" /></div><div class="col-12"><label asp-for="Description" class="form-label">Descrição</label><textarea asp-for="Description" class="form-control" rows="3" maxlength="500"></textarea></div><div class="col-12 d-flex gap-2"><button class="btn btn-primary">Salvar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></div></form></main>
