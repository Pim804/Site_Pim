@model OptiStock.Web.Controllers.MovementsController.MovementForm
@{ ViewData["Title"] = "Nova movimentação"; var result = ViewBag.Parts as OptiStock.Web.Controllers.MovementsController.PartPage; }
<main class="container py-4 form-page"><h1 class="h2">Nova movimentação</h1><p class="text-secondary">A API atualiza o saldo e registra o histórico na mesma transação.</p>
<form asp-action="Create" method="post" class="card" data-loading-form data-confirm-submit="Confirme a movimentação de estoque."><div class="card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="col-12"><label asp-for="PartId" class="form-label">Peça</label><select asp-for="PartId" class="form-select" data-part-select required><option value="">Selecione</option>@if (result is not null) { @foreach (var p in result.Items) { <option value="@p.Id" data-stock="@p.StockQuantity">@p.Code · @p.Name (saldo: @p.StockQuantity)</option> } }</select><p class="form-text" data-current-stock aria-live="polite">Selecione uma peça para consultar o saldo atual.</p></div>
<div class="col-md-6"><label asp-for="Type" class="form-label">Tipo</label><select asp-for="Type" class="form-select"><option value="entry">Entrada</option><option value="exit">Saída</option></select></div>
<div class="col-md-6"><label asp-for="Quantity" class="form-label">Quantidade</label><input asp-for="Quantity" type="number" min="1" class="form-control" data-movement-quantity required /><p class="text-danger small" data-movement-client-error role="alert" hidden></p></div>
<div class="col-12"><label asp-for="Notes" class="form-label">Observações</label><textarea asp-for="Notes" class="form-control" rows="3"></textarea></div>
<div class="col-12 d-flex gap-2"><button class="btn btn-primary" type="submit" data-loading-label="Registrando…">Registrar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></div></form></main>
