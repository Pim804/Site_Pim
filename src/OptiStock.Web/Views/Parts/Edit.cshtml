@model OptiStock.Web.Controllers.PartsController.EditPartForm
@{ var id = ViewBag.Id as int?; ViewData["Title"] = "Editar peça"; var categories = ViewBag.Categories as List<OptiStock.Web.Controllers.PartsController.CategoryOption> ?? []; var suppliers = ViewBag.Suppliers as List<OptiStock.Web.Controllers.PartsController.SupplierOption> ?? []; }
<main class="container py-4 form-page"><h1 class="h2">Editar peça</h1><p class="text-secondary">A quantidade é alterada somente por uma movimentação rastreável.</p>
<form asp-action="Edit" asp-route-id="@id" method="post" class="card"><div class="card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="col-md-6"><label asp-for="Code" class="form-label">Código</label><input asp-for="Code" class="form-control" required /></div><div class="col-md-6"><label asp-for="Name" class="form-label">Nome</label><input asp-for="Name" class="form-control" required /></div>
<div class="col-md-6"><label asp-for="CategoryId" class="form-label">Categoria</label><select asp-for="CategoryId" class="form-select" required><option value="">Selecione</option>@foreach (var c in categories) { <option value="@c.Id">@c.Name</option> }</select></div>
<div class="col-md-6"><label asp-for="SupplierId" class="form-label">Fornecedor (opcional)</label><select asp-for="SupplierId" class="form-select"><option value="">Sem fornecedor</option>@foreach (var s in suppliers) { <option value="@s.Id">@s.Name</option> }</select></div>
<div class="col-md-4"><label asp-for="MinimumStock" class="form-label">Estoque mínimo</label><input asp-for="MinimumStock" type="number" min="0" class="form-control" /></div><div class="col-md-4"><label asp-for="UnitPrice" class="form-label">Preço unitário</label><input asp-for="UnitPrice" type="number" min="0" step="0.01" class="form-control" /></div><div class="col-md-4"><label asp-for="WarehouseLocation" class="form-label">Endereço</label><input asp-for="WarehouseLocation" class="form-control" /></div>
<div class="col-12"><label asp-for="Description" class="form-label">Descrição</label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-12 d-flex gap-2"><button class="btn btn-primary">Salvar alterações</button><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div></div></form></main>
