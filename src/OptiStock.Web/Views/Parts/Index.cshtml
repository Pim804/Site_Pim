@model OptiStock.Web.Controllers.PartsController.PageModel
@{ ViewData["Title"] = "Estoque"; }
<main class="container py-4"><header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h2">Estoque</h1><p class="text-secondary">Pesquise peças por nome ou código.</p></div>
@if (User.IsInRole("Administrador")) { <a asp-action="Create" class="btn btn-primary">Cadastrar peça</a> }</header>
@if (Model.Error is not null) { <div class="alert alert-warning" role="status">@Model.Error</div> } @if (TempData["Error"] is string actionError) { <div class="alert alert-danger">@actionError</div> }
<form method="get" class="row g-2 mb-3"><div class="col"><label class="visually-hidden" for="busca">Nome ou código</label><input id="busca" name="busca" value="@Model.Busca" class="form-control" placeholder="Nome ou código" /></div><div class="col-auto"><button class="btn btn-outline-primary">Pesquisar</button></div></form>
@if (Model.Results is { } results) { <div class="table-responsive"><table class="table table-striped align-middle"><thead><tr><th>Código</th><th>Peça</th><th>Categoria</th><th>Saldo</th><th>Preço</th><th>Endereço</th><th>Situação</th>@if (User.IsInRole("Administrador")) { <th>Ações</th> }</tr></thead><tbody>
@foreach (var item in results.Items) { <tr><td>@item.Code</td><th scope="row">@item.Name</th><td>@item.Category</td><td>@item.StockQuantity</td><td>@item.UnitPrice.ToString("C")</td><td>@item.WarehouseLocation</td><td>@item.Status</td>@if (User.IsInRole("Administrador")) { <td class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="Deactivate" asp-route-id="@item.Id" method="post" data-confirm-submit="Desativar esta peça? O histórico será mantido.">@Html.AntiForgeryToken()<button type="submit" class="btn btn-sm btn-outline-danger">Desativar</button></form></td> }</tr> }
</tbody></table></div> <p class="text-secondary">@results.Total peça(s) no resultado.</p> }</main>
