@model List<OptiStock.Web.Controllers.SuppliersController.SupplierRow>
@{ ViewData["Title"] = "Fornecedores"; }
<main class="container py-4"><header class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Fornecedores</h1><p class="text-secondary">Gerencie parceiros ligados às peças.</p></div><a asp-action="Create" class="btn btn-primary">Novo fornecedor</a></header>
@if (ViewData["Error"] is string error) { <div class="alert alert-warning">@error</div> } @if (TempData["Error"] is string actionError) { <div class="alert alert-danger">@actionError</div> }
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Fornecedor</th><th>CNPJ</th><th>Telefone</th><th>E-mail</th><th>Ações</th></tr></thead><tbody>@foreach (var item in Model) { <tr><th scope="row">@item.Name</th><td>@item.TaxId</td><td>@item.Phone</td><td>@item.Email</td><td class="d-flex gap-2"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="Deactivate" asp-route-id="@item.Id" method="post">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit">Desativar</button></form></td></tr> }</tbody></table></div></main>
