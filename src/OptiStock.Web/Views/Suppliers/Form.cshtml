@model OptiStock.Web.Controllers.SuppliersController.SupplierForm
@{ var id = ViewBag.Id as int?; ViewData["Title"] = id is null ? "Novo fornecedor" : "Editar fornecedor"; }
<main class="container py-4 form-page"><h1 class="h2">@ViewData["Title"]</h1><form asp-action="@(id is null ? "Create" : "Edit")" asp-route-id="@id" method="post" class="card mt-3"><div class="card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="col-md-6"><label asp-for="Name" class="form-label">Nome/Razão social</label><input asp-for="Name" class="form-control" required maxlength="180" /></div><div class="col-md-6"><label asp-for="TaxId" class="form-label">CNPJ (opcional)</label><input asp-for="TaxId" class="form-control" maxlength="18" /></div>
<div class="col-md-6"><label asp-for="Phone" class="form-label">Telefone</label><input asp-for="Phone" class="form-control" maxlength="30" /></div><div class="col-md-6"><label asp-for="Email" class="form-label">E-mail</label><input asp-for="Email" type="email" class="form-control" maxlength="254" /></div><div class="col-12"><label asp-for="Address" class="form-label">Endereço</label><textarea asp-for="Address" class="form-control" rows="3"></textarea></div>
<div class="col-12 d-flex gap-2"><button class="btn btn-primary">Salvar</button><a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a></div></div></form></main>
