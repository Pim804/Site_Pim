@model OptiStock.Web.Controllers.AnnouncementsController.AnnouncementPage
@{ ViewData["Title"] = "Comunicados"; }
<main class="container py-4"><header class="d-flex justify-content-between align-items-center gap-3 mb-4"><div><h1 class="h2">Comunicados internos</h1><p class="text-secondary">Avisos da equipe OptiStock.</p></div>@if (User.IsInRole("Administrador")) { <a asp-action="Create" class="btn btn-primary">Novo comunicado</a> }</header>
@if (ViewData["ApiUnavailable"] is string error) { <div class="alert alert-warning" role="status">@error</div> } @if (TempData["Error"] is string actionError) { <div class="alert alert-danger">@actionError</div> }
@if (Model is not null) { @foreach (var item in Model.Items) { <article class="card mb-3"><div class="card-body"><h2 class="h5">@item.Title</h2><p class="text-secondary small">@item.Author · @((item.PublishedAtUtc ?? item.CreatedAtUtc).ToLocalTime().ToString("g"))</p><p class="mb-0" style="white-space:pre-wrap">@item.Content</p>
@if (User.IsInRole("Administrador")) { <div class="d-flex gap-2 mt-3"><a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Editar</a><form asp-action="Archive" asp-route-id="@item.Id" method="post" data-confirm-submit="Arquivar este comunicado?">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger" type="submit">Arquivar</button></form></div> }</div></article> } if (Model.Items.Count == 0) { <p>Nenhum comunicado publicado.</p> } }</main>
