@model OptiStock.Web.Controllers.AnnouncementsController.AnnouncementForm
@{ var id = ViewBag.Id as int?; ViewData["Title"] = id is null ? "Novo comunicado" : "Editar comunicado"; }
<main class="container py-4 form-page"><h1 class="h2">@ViewData["Title"]</h1><form asp-action="@(id is null ? "Create" : "Edit")" asp-route-id="@id" method="post" class="card mt-3"><div class="card-body row g-3">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
<div class="col-12"><label asp-for="Title" class="form-label">Título</label><input asp-for="Title" class="form-control" maxlength="180" required /></div><div class="col-12"><label asp-for="Content" class="form-label">Conteúdo</label><textarea asp-for="Content" class="form-control" rows="7" maxlength="10000" required></textarea></div><div class="col-12 form-check ms-2"><input asp-for="IsPublished" class="form-check-input" /><label asp-for="IsPublished" class="form-check-label">Publicar agora</label></div>
<div class="col-12 d-flex gap-2"><button class="btn btn-primary" type="submit">Salvar</button><a asp-action="Index" class="btn btn-outline-secondary">Voltar</a></div></div></form></main>
