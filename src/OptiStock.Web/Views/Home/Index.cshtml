@{ ViewData["Title"] = "Início"; ViewData["BodyClass"] = "home-page"; }
<main class="container launcher-page editorial-home" id="main-content">
    <section class="home-hero editorial-home-hero" aria-labelledby="home-title">
        <div class="home-copy editorial-home-copy">
            <p class="eyebrow"><span class="home-kicker-dot"></span> OPTISTOCK / CONTROLE DE ESTOQUE</p>
            <h1 id="home-title">O estoque em foco.<br /><span>O trabalho flui.</span></h1>
            <p>Localize peças, confira saldos e acompanhe cada movimentação com a informação organizada onde sua equipe precisa.</p>
            <a asp-controller="Parts" asp-action="Index" class="btn btn-primary home-cta">Abrir estoque <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg></a>
        </div>
        <aside class="home-visual editorial-home-visual" aria-label="Controle de estoque do OptiStock">
            <div class="home-visual-content">
                <span class="home-visual-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14.4 6.2 18 2.8a6.4 6.4 0 0 0-8.3 8.1l-6.4 6.4a2 2 0 0 0 2.8 2.8l6.4-6.4a6.4 6.4 0 0 0 8.1-8.3l-3.4 3.6a2 2 0 0 1-2.8-2.8Z" /></svg></span>
                <div><strong>Seu estoque,<br />sem pontos cegos.</strong><span>Peças, saldos e histórico em um só lugar.</span></div>
            </div>
            <div class="home-visual-shelf" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <span class="home-visual-caption">INFORMAÇÃO CLARA PARA CADA MOVIMENTO</span>
        </aside>
    </section>
    <section class="home-entry-section" aria-labelledby="modules-title">
        <header class="home-modules-heading editorial-modules-heading"><div><p class="editorial-section-kicker">SEU ESPAÇO DE TRABALHO</p><h2 id="modules-title">Por onde vamos começar?</h2></div><span class="text-secondary small">Acesso direto às áreas do OptiStock</span></header>
        <div class="module-launcher editorial-module-launcher">
            <a class="module-card editorial-module-card" asp-controller="Portal" asp-action="Index"><span class="module-icon icon-people" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3.5 19a5.5 5.5 0 0 1 11 0M16 5.5a3 3 0 0 1 0 5.8M17 14a5 5 0 0 1 3.5 4.8"/></svg></span><span class="module-copy"><strong>Portal do funcionário</strong><small>Comunicados e informações da equipe</small></span><span class="module-arrow" aria-hidden="true">↗</span></a>
            <a class="module-card editorial-module-card" asp-controller="Parts" asp-action="Index"><span class="module-icon icon-stock" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="m12 2.8 8.3 4.5v9.4L12 21.2l-8.3-4.5V7.3L12 2.8Z"/><path d="m3.9 7.4 8.1 4.5 8.1-4.5M12 11.9v9"/></svg></span><span class="module-copy"><strong>Estoque</strong><small>Peças, quantidades e localização</small></span><span class="module-arrow" aria-hidden="true">↗</span></a>
            @if (User.IsInRole("Administrador"))
            {
                <a class="module-card editorial-module-card" asp-controller="Home" asp-action="Dashboard"><span class="module-icon icon-management" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 19.5h16M5.5 17V10m4.4 7V5m4.3 12v-4m4.3 4V8"/><path d="m4.5 8.5 5.4-4 4.3 5.2 5.5-4"/></svg></span><span class="module-copy"><strong>Gerência</strong><small>Indicadores e visão do estoque</small></span><span class="module-arrow" aria-hidden="true">↗</span></a>
            }
            @if (User.IsInRole("Administrador"))
            {
                <a class="module-card editorial-module-card" asp-controller="Parts" asp-action="Create"><span class="module-icon icon-create" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4.5v15M4.5 12h15"/><circle cx="12" cy="12" r="9.2"/></svg></span><span class="module-copy"><strong>Cadastrar peça</strong><small>Adicione um item ao catálogo</small></span><span class="module-arrow" aria-hidden="true">↗</span></a>
            }
            <a class="module-card editorial-module-card" asp-controller="Movements" asp-action="Index"><span class="module-icon icon-movement" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4 7h14l-3-3m5 3v4M20 17H6l3 3m-5-3v-4"/></svg></span><span class="module-copy"><strong>Movimentações</strong><small>Entradas, saídas e histórico</small></span><span class="module-arrow" aria-hidden="true">↗</span></a>
        </div>
        @if (User.IsInRole("Administrador"))
        {
            <nav class="module-admin-links editorial-admin-links" aria-label="Outros cadastros administrativos"><a asp-controller="Categories" asp-action="Index">Categorias</a><span aria-hidden="true">·</span><a asp-controller="Suppliers" asp-action="Index">Fornecedores</a><span aria-hidden="true">·</span><a asp-controller="Users" asp-action="Index">Usuários</a><span aria-hidden="true">·</span><a asp-controller="Announcements" asp-action="Index">Comunicados</a></nav>
        }
    </section>
</main>
